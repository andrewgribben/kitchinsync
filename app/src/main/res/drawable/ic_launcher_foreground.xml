<?xml version="1.0" encoding="utf-8"?>
<!-- Shallow Belfast sink with a cloud rising out of it like bubbles. 108dp viewport.
     Everything sits inside the 66dp safe zone (21..87) except the rim ends, which touch it.
     Cloud: three circles (r 7 / 10 / 6, centres x 41 / 54.5 / 68) cut off on the line y=45,
     3 units above the rim top (y=48) so the background shows as a gap between the two whites.
     Rim: x 21..87, y 48..56, r=3. Basin: x 25..83, y 55..72 (1 unit under the rim), r=3. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- cloud / bubbles -->
    <path
        android:pathData="M34.02,45 A7,7 0 0 1 45.68,40.29 A10,10 0 0 1 63.77,41.25 A6,6 0 0 1 73.98,45 Z"
        android:fillColor="#F4F8FB" />

    <!-- rim -->
    <path
        android:pathData="M24,48 L84,48 A3,3 0 0 1 87,51 L87,53 A3,3 0 0 1 84,56 L24,56 A3,3 0 0 1 21,53 L21,51 A3,3 0 0 1 24,48 Z"
        android:fillColor="#FFFFFF" />

    <!-- basin -->
    <path
        android:pathData="M25,55 L83,55 L83,69 A3,3 0 0 1 80,72 L28,72 A3,3 0 0 1 25,69 Z"
        android:fillColor="#FFFFFF" />
</vector>
