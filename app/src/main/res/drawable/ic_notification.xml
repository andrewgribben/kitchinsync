<?xml version="1.0" encoding="utf-8"?>
<!-- 24dp status-bar / account small icon: the same sink + cloud as the launcher foreground,
     cropped to a 72-unit window (x 18..90, y 18..90) so 3 viewport units = 1dp. The content
     spans 22dp wide, the rim top lands on a pixel row (y=30 -> 10dp) and the 3-unit gap is
     exactly 1px at mdpi, so cloud and sink stay separate. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="72"
    android:viewportHeight="72"
    android:tint="#FFFFFF">

    <group android:translateX="-18" android:translateY="-18">
        <!-- cloud / bubbles -->
        <path
            android:pathData="M34.02,45 A7,7 0 0 1 45.68,40.29 A10,10 0 0 1 63.77,41.25 A6,6 0 0 1 73.98,45 Z"
            android:fillColor="#FFFFFF" />

        <!-- rim -->
        <path
            android:pathData="M24,48 L84,48 A3,3 0 0 1 87,51 L87,53 A3,3 0 0 1 84,56 L24,56 A3,3 0 0 1 21,53 L21,51 A3,3 0 0 1 24,48 Z"
            android:fillColor="#FFFFFF" />

        <!-- basin -->
        <path
            android:pathData="M25,55 L83,55 L83,69 A3,3 0 0 1 80,72 L28,72 A3,3 0 0 1 25,69 Z"
            android:fillColor="#FFFFFF" />
    </group>
</vector>
